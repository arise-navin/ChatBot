# ==============================================================================
# Neon PostgreSQL Database Connection
# ==============================================================================
DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require&channel_binding=require

# ==============================================================================
# Ollama Beam:Cloud Model Configuration
# ==============================================================================
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_BASE_URL=https://ollama.com/api/chat
OLLAMA_MODEL=beam:cloud

# ==============================================================================
# REST API & Tracker Configuration
# ==============================================================================
REST_API_CONNECTION_NAME=Beam-Ollama-Production-Tracker
REST_API_BASE_URL=https://chatbot.<your-subdomain>.workers.dev
REST_API_HOST=0.0.0.0
REST_API_PORT=8000
REST_API_HEADER_NAME=x-api-key
REST_API_KEY=your_rest_api_key_token_here

# ==============================================================================
# Signet Workload Identity & Safety Gateway Configuration
# ==============================================================================
SIGNET_CONTROL_URL=https://control.signet.security
SIGNET_GATEWAY_URL=https://gateway.signet.security
SIGNET_AGENT_ID=agt_your_agent_id_here
SIGNET_DEPLOYMENT_CREDENTIAL=your_signet_deployment_credential_here
SIGNET_WORKLOAD_REFRESH_TOKEN=your_signet_refresh_token_here
